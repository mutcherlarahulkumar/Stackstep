# All read at runtime by the Next.js server, so one image works in every environment.
# Where /api/* is proxied (the Go API).
API_INTERNAL_URL=http://localhost:8080
# WebSocket endpoint the browser connects to for live chat (the API's /v1/ws).
PUBLIC_WS_URL=ws://localhost:8080/v1/ws
# Same value as the API (32+ chars). Rate limits then count each student, not the proxy.
PROXY_SHARED_SECRET=
