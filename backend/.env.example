# API settings for `make api` / `make seed` (copy to backend/.env). Full reference: docs/SETUP.md §6.
DATABASE_URL=postgres://stackstep:stackstep@localhost:5432/stackstep?sslmode=disable
APP_ENV=development
HTTP_ADDR=:8080
# Required (>= 32 bytes) in production. Generate with: openssl rand -base64 48
JWT_SECRET=
OAUTH_STATE_SECRET=
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
MOBILE_REDIRECT_URL=stackstep://auth
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Same value as the web app; lets its proxy pass visitor IPs for rate limiting (32+ chars).
PROXY_SHARED_SECRET=
AUTH_RATE_PER_MINUTE=30
LEAD_REPLY_DELAY=5s
DELIVERY_INTERVAL=1s

# Real GitHub sign-in (optional locally, required in production).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3000/api/v1/auth/github/callback
BOOTSTRAP_ADMIN_GITHUB_LOGINS=

# Student AI helper. Empty key = helper off. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT=25s
AI_DAILY_QUESTIONS=8
AI_QUESTION_COOLDOWN=2m
AI_FOLLOWUP_COOLDOWN=5m
AI_MAX_FOLLOWUPS=3
AI_GLOBAL_PER_MINUTE=30
