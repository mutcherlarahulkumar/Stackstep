# Optional values Docker Compose fills into the stack (copy to .env). See docs/SETUP.md.
# Student AI helper (Groq). Empty = helper off. Key: https://console.groq.com/keys
GROQ_API_KEY=
# Real GitHub sign-in. Callback: http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BOOTSTRAP_ADMIN_GITHUB_LOGINS=
